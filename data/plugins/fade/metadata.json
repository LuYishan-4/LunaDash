{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.ludash.fade",
  "name": "Window fade",
  "description": "A configurable native window animation profile.",
  "version": "2.0.0",
  "author": "LunaDash contributors",
  "icon": "preferences-desktop-effects",
  "tags": [
    "Animation",
    "Native"
  ],
  "type": "effect",
  "target": "window-animation",
  "mode": "replace",
  "entry": "libludash-fade.so",
  "enabledByDefault": false,
  "settings": {
    "duration": {
      "type": "integer",
      "control": "number",
      "label": "Animation duration",
      "description": "Milliseconds; zero disables animation.",
      "default": 260,
      "minimum": 0,
      "maximum": 600,
      "step": 10
    },
    "softFocus": {
      "type": "boolean",
      "control": "toggle",
      "label": "Fade on focus",
      "default": true
    },
    "easing": {
      "type": "string",
      "control": "select",
      "label": "Easing curve",
      "default": "outQuint",
      "enum": [
        "linear",
        "outCubic",
        "outQuint",
        "inOutCubic"
      ]
    },
    "exitScale": {
      "type": "number",
      "control": "slider",
      "label": "Closing scale",
      "default": 1,
      "minimum": 0.5,
      "maximum": 1,
      "step": 0.01
    }
  }
}
