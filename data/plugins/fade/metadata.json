{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.ludash.fade",
  "name": "Window fade",
  "description": "A configurable native window animation profile.",
  "version": "2.0.0",
  "author": "LunaDash contributors",
  "type": "effect",
  "target": "window-animation",
  "mode": "replace",
  "entry": "libludash-fade.so",
  "enabledByDefault": false,
  "settings": {
    "duration": {
      "type": "integer",
      "default": 260,
      "minimum": 0,
      "maximum": 600
    }
  }
}
