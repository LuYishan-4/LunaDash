{
  "schemaVersion": 1,
  "format": "lunadash-plugin-index",
  "plugins": [
    {
      "id": "org.lunadash.kde-behavior",
      "name": "KDE Behavior Pack",
      "description": "KDE-inspired taskbar, window-rule and window-animation behavior packaged as one multi-target LunaDash plugin.",
      "version": "1.0.0",
      "author": "LunaDash contributors",
      "icon": "preferences-desktop",
      "targets": [
        {
          "id": "panel",
          "target": "panel",
          "type": "quickshell",
          "mode": "replace",
          "settings": {
            "compact": {
              "type": "boolean",
              "control": "toggle",
              "label": "Compact task buttons",
              "default": false
            },
            "showLabels": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show window titles",
              "default": true
            },
            "showWorkspaceSwitcher": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show workspace switcher",
              "default": true
            }
          }
        },
        {
          "id": "window-rules",
          "target": "window-rules",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "workspacePolicy": {
              "type": "string",
              "control": "select",
              "label": "New-window workspace policy",
              "default": "current",
              "enum": [
                "current",
                "first",
                "remember"
              ]
            },
            "maximizeNewWindows": {
              "type": "boolean",
              "control": "toggle",
              "label": "Maximize new windows",
              "default": false
            }
          }
        },
        {
          "id": "window-animation",
          "target": "window-animation",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "duration": {
              "type": "integer",
              "control": "number",
              "label": "Animation duration",
              "default": 220,
              "minimum": 0,
              "maximum": 600,
              "step": 10
            },
            "enterOffset": {
              "type": "integer",
              "control": "number",
              "label": "Opening offset",
              "default": 8,
              "minimum": -100,
              "maximum": 100,
              "step": 1
            },
            "focusOpacity": {
              "type": "number",
              "control": "slider",
              "label": "Unfocused opacity",
              "default": 0.9,
              "minimum": 0,
              "maximum": 1,
              "step": 0.01
            },
            "exitScale": {
              "type": "number",
              "control": "slider",
              "label": "Closing scale",
              "default": 0.96,
              "minimum": 0.5,
              "maximum": 1,
              "step": 0.01
            },
            "easing": {
              "type": "string",
              "control": "select",
              "label": "Easing curve",
              "default": "outCubic",
              "enum": [
                "linear",
                "outCubic",
                "outQuint",
                "inOutCubic"
              ]
            }
          }
        }
      ],
      "tags": [
        "KDE",
        "Panel",
        "Windows",
        "Animation",
        "Multi-target"
      ],
      "sourceUrl": "https://github.com/LuYishan-4/LunaDash-Plugins/tree/main/plugins/org.lunadash.kde-behavior",
      "siteUrl": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.kde-behavior/",
      "license": "GPL-3.0-or-later",
      "repository": "https://github.com/LuYishan-4/LunaDash-Plugins",
      "featured": true,
      "deprecated": false,
      "homepage": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.kde-behavior/"
    }
  ]
}
