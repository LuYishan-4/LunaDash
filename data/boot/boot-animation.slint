// LunaDash's boot animation. Plymouth plays it as a loop of two seconds, so
// whatever moves here should come back to where it started after 2s. To use
// another: copy this file, change it and run `lunadash-boot-animation FILE`.
export component BootAnimation inherits Window {
    width: 560px;
    height: 240px;
    background: #000000;

    // 0 → 1 over two seconds, again and again: everything follows it.
    property <float> phase: 0;
    animate phase {
        duration: 2s;
        iteration-count: -1;
    }
    init => {
        root.phase = 1;
    }
    property <float> breath: (1 - cos(root.phase * 360deg)) / 2;

    brand := HorizontalLayout {
        y: 54px;
        height: 96px;
        alignment: center;
        spacing: 22px;
        Rectangle {
            width: 96px;
            Rectangle {
                width: 150px;
                height: 150px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: @radial-gradient(circle, #9db8ff38 0%, #9db8ff00 70%);
                opacity: 0.45 + 0.55 * root.breath;
            }
            Image {
                source: @image-url("luna-mark.svg");
                width: 96px;
                height: 96px;
            }
        }
        Text {
            text: "LUNADASH";
            color: #eef2ff;
            font-size: 34px;
            font-weight: 300;
            letter-spacing: 9px;
            vertical-alignment: center;
        }
    }

    // A light that travels along three dots, one turn per loop.
    for index in 3: Rectangle {
        property <float> distance: abs(mod(root.phase * 3 - index + 1.5, 3) - 1.5);
        property <float> light: max(0, 1 - distance);
        width: 9px;
        height: 9px;
        x: (root.width - 3 * 9px - 2 * 14px) / 2 + index * (9px + 14px);
        y: 186px;
        border-radius: 4.5px;
        border-width: 1.5px;
        border-color: #eef2ff99;
        background: #eef2ff.with-alpha(self.light * 0.95);
    }
}
