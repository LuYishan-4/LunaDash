---
import "../styles.css";
import "../docs.css";

interface Props {
  title: string;
  tag: string;
  publishedAt: string;
  releaseUrl: string;
  prerelease?: boolean;
}

const { title, tag, publishedAt, releaseUrl, prerelease = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const date = publishedAt ? new Date(publishedAt).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" }) : "Unpublished";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={`Release notes for LunaDash ${tag}`} />
  <meta name="theme-color" content="#101b1d" />
  <title>{title} · LunaDash release notes</title>
  <link rel="icon" href={`${base}assets/mark.svg`} />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="nav wrap">
  <a class="brand" href={base}><img src={`${base}assets/mark.svg`} width="28" height="28" alt="" /> LunaDash</a>
  <nav aria-label="Main navigation"><a href={`${base}releases/`}>Release notes</a><a href={`${base}docs/start/`}>Guides</a><a class="source" href="https://github.com/LuYishan-4/LunaDash">Source ↗</a></nav>
</header>
<main id="content" class="docs-main wrap">
  <div class="eyebrow">RELEASE / {tag}{prerelease ? " / PRERELEASE" : ""}</div>
  <h1>{title}</h1>
  <p class="docs-lead">Published {date}. This page is generated from the matching GitHub Release Markdown.</p>
  <p><a class="text-link" href={releaseUrl}>View this release on GitHub ↗</a></p>
  <article class="release-markdown"><slot /></article>
</main>
<footer class="wrap"><a class="brand" href={base}>LunaDash</a><span>Release notes are synced from GitHub Releases.</span><a href={`${base}releases/`}>All releases ↗</a></footer>
</body>
</html>
