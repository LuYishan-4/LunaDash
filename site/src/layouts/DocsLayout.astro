---
import "../styles.css";
import "../docs.css";
interface Props { title: string; summary: string; section: string; }
const { title, summary, section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pages = [["settings", "Desktop settings"], ["modules", "Build your shell"], ["api", "API reference"], ["start", "Run & test"]];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={summary} /><meta name="theme-color" content="#101b1d" />
  <title>{title} · LunaDash Docs</title><link rel="icon" href={`${base}assets/mark.svg`} />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="nav wrap"><a class="brand" href={base}><img src={`${base}assets/mark.svg`} width="28" height="28" alt="" /> LunaDash <span class="docs-badge">GUIDES</span></a><nav aria-label="Main navigation"><a href={base}>Desktop</a><a class="source" href="https://github.com/LuYishan-4/LuDash">Source ↗</a></nav></header>
<div class="docs-layout wrap">
  <aside class="docs-sidebar"><span class="eyebrow">MAKE YOURSELF AT HOME</span><nav aria-label="Documentation">{pages.map(([id, label]) => <a href={`${base}docs/${id}/`} aria-current={section === id ? "page" : undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav><p>Version 0.1 · Development preview<br />Arch Linux first. Wayland native.</p><a class="text-link" href="https://github.com/LuYishan-4/LuDash/blob/main/docs/TESTING_AND_FILES.md">Every source file ↗</a></aside>
  <main id="content" class="docs-main"><div class="eyebrow">LUDASH / {section.toUpperCase()}</div><h1>{title}</h1><p class="docs-lead">{summary}</p><slot /></main>
</div>
<footer class="wrap"><a class="brand" href={base}>LunaDash</a><span>Small details. Your workspace.</span><a href={`${base}docs/api/`}>API reference ↗</a></footer>
</body>
</html>
