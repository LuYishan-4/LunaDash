---
import "../../styles.css";
import "../../docs.css";
import releases from "../../data/releases.json";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const entries = releases as Array<{
  title: string;
  tag: string;
  slug: string;
  publishedAt: string;
  releaseUrl: string;
  prerelease: boolean;
}>;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="LunaDash release notes synced from GitHub Releases." />
  <meta name="theme-color" content="#101b1d" />
  <title>Release notes · LunaDash</title>
  <link rel="icon" href={`${base}assets/mark.svg`} />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="nav wrap">
  <a class="brand" href={base}><img src={`${base}assets/mark.svg`} width="28" height="28" alt="" /> LunaDash</a>
  <nav aria-label="Main navigation"><a href={`${base}docs/start/`}>Guides</a><a class="source" href="https://github.com/LuYishan-4/LunaDash/releases">GitHub Releases ↗</a></nav>
</header>
<main id="content" class="docs-main wrap">
  <div class="eyebrow">LUNADASH / RELEASES</div>
  <h1>Release notes</h1>
  <p class="docs-lead">Each page is generated from the Markdown body of the matching GitHub Release. Publishing, editing or deleting a release is reflected the next time the website deploys.</p>

  {entries.length === 0 ? (
    <div class="callout">No published GitHub Releases are available yet.</div>
  ) : (
    <div class="docs-grid">
      {entries.map((release) => (
        <article class="docs-card">
          <div class="eyebrow">{release.prerelease ? "PRERELEASE" : "RELEASE"} / {release.tag}</div>
          <h2><a href={`${base}releases/${release.slug}/`}>{release.title}</a></h2>
          <p>{release.publishedAt ? new Date(release.publishedAt).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" }) : "Unpublished"}</p>
          <a class="text-link" href={`${base}releases/${release.slug}/`}>Read update notes ↗</a>
        </article>
      ))}
    </div>
  )}
</main>
<footer class="wrap"><a class="brand" href={base}>LunaDash</a><span>GitHub Release Markdown is the source of truth.</span><a href="https://github.com/LuYishan-4/LunaDash/releases">GitHub Releases ↗</a></footer>
</body>
</html>
