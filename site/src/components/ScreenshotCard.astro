---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  title: string;
  description: string;
  alt: string;
  featured?: boolean;
}

const { src, title, description, alt, featured = false } = Astro.props;
---
<figure class:list={["screenshot", { featured }]}>
  <a href={src.src} class="screenshot-link" data-lightbox data-title={title} aria-label={`View full screenshot: ${title}`}>
    <Image src={src} alt={alt} format="webp" quality={82}
      widths={[480, 800, 1200, 1920].filter(width => width <= src.width)}
      sizes={featured ? "(min-width: 1260px) 1164px, calc(100vw - 44px)" : "(min-width: 1000px) 370px, (min-width: 680px) 45vw, calc(100vw - 44px)"}
      loading={featured ? "eager" : "lazy"} fetchpriority={featured ? "high" : "auto"} />
    <span class="screenshot-open" aria-hidden="true">View full size ↗</span>
  </a>
  <figcaption><strong>{title}</strong><span>{description}</span></figcaption>
</figure>
