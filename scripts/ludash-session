#!/bin/sh
set -eu
check_only=0
if [ "${1:-}" = --check ]; then check_only=1; shift; fi
session_bin=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
if [ "$(id -u)" = 0 ]; then echo 'LunaDash must run as a normal login user, not root.' >&2; exit 1; fi
# Only these are required to bring up the desktop. A terminal (kitty) and a
# shell are optional defaults: missing them must not block login.
for program in quickshell; do
    command -v "$program" >/dev/null || { echo "Missing session dependency: $program" >&2; exit 1; }
done
# A TTY/manual login may omit the address even though PAM already started
# the systemd user bus. Reuse that bus instead of isolating portal clients.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    command -v dbus-run-session >/dev/null || {
        echo "Missing session dependency: dbus-run-session" >&2
        exit 1
    }
fi
for program in kitty; do
    command -v "$program" >/dev/null || echo "Note: optional default terminal '$program' is not installed." >&2
done
compositor="$session_bin/lunadash-compositor"
if [ ! -x "$compositor" ]; then compositor="$session_bin/ludash-compositor"; fi
if [ ! -x "$compositor" ]; then echo 'Install LunaDash before using lunadash-session.' >&2; exit 1; fi
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ] || [ ! -O "$XDG_RUNTIME_DIR" ]; then
    echo 'A user-owned XDG_RUNTIME_DIR from a PAM/logind login is required.' >&2; exit 1
fi
if [ "$check_only" = 1 ]; then
    echo 'Session commands and login runtime are present. GPU, input access and VT switching still require a physical login test.'
    exit 0
fi
case "${LUDASH_GRAPHICS:-gles}" in auto|opengl|gles) ;; *) echo 'LUDASH_GRAPHICS must be auto, opengl or gles.' >&2; exit 2 ;; esac
umask 077
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/lunadash
mkdir -p -- "$state_dir"
session_log=$(mktemp "$state_dir/session-XXXXXXXX")
mv -- "$session_log" "$session_log.log"
session_log="$session_log.log"
echo "LunaDash session log: $session_log"
exec >>"$session_log" 2>&1
# A user-level generic portals.conf from another desktop takes precedence
# over /usr/share. Seed a LunaDash-only file without modifying that generic
# file or replacing an explicit user choice. No writes happen in --check.
portal_config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/xdg-desktop-portal
portal_config="$portal_config_dir/lunadash-portals.conf"
portal_defaults="$session_bin/../share/xdg-desktop-portal/lunadash-portals.conf"
if [ ! -r "$portal_defaults" ]; then
    portal_defaults=/usr/share/xdg-desktop-portal/lunadash-portals.conf
fi
if [ ! -e "$portal_config" ] && [ ! -L "$portal_config" ] && [ -r "$portal_defaults" ]; then
    if mkdir -p -- "$portal_config_dir" && (set -C; cat -- "$portal_defaults" > "$portal_config"); then
        echo "LunaDash portal configuration: $portal_config"
    else
        echo "Warning: could not create desktop-specific portal configuration." >&2
    fi
fi
unset DISPLAY WAYLAND_DISPLAY QT_QUICK_BACKEND LIBGL_ALWAYS_SOFTWARE MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
eglfs_integration=${QT_QPA_EGLFS_INTEGRATION:-eglfs_kms}
unset QT_QPA_PLATFORM QT_QPA_EGLFS_INTEGRATION
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=LunaDash
export XDG_SESSION_DESKTOP=LunaDash
export XMODIFIERS=@im=fcitx
export QT_IM_MODULE=fcitx
export QT_IM_MODULES='wayland;fcitx;ibus'
export GTK_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx
# Make the LunaDash xdg-desktop-portal FileChooser the common path for
# unsandboxed toolkit applications as well as Flatpak/sandboxed clients.
export GTK_USE_PORTAL=1
export QT_QPA_PLATFORMTHEME=xdgdesktopportal
export QSG_RHI_BACKEND=opengl
# Once the compositor owns its Wayland socket it publishes WAYLAND_DISPLAY and
# the LunaDash desktop identity to D-Bus activation and the systemd user
# manager, so portal services start in this compositor session.
export LUNADASH_PUBLISH_ACTIVATION_ENV=1
# Keep the login session's existing user D-Bus when available. Replacing it
# with an unconditional dbus-run-session isolates Discord/Chromium from the
# systemd user xdg-desktop-portal and xdg-desktop-portal-wlr services, which
# prevents ScreenCast from returning a PipeWire stream.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec env QT_QPA_PLATFORM=eglfs QT_QPA_EGLFS_INTEGRATION="$eglfs_integration" \
        "$compositor" --fullscreen --graphics "${LUDASH_GRAPHICS:-gles}" "$@"
fi

# Minimal/manual launches without a PAM/systemd user bus still need a session
# bus for portals and the rest of the desktop.
exec dbus-run-session -- env QT_QPA_PLATFORM=eglfs QT_QPA_EGLFS_INTEGRATION="$eglfs_integration" \
    "$compositor" --fullscreen --graphics "${LUDASH_GRAPHICS:-gles}" "$@"
