#!/usr/bin/env bash
# Makes a Slint animation the system's boot splash, as a Plymouth theme.
#
#   lunadash-boot-animation [--size WxH] [--font FONT] [FILE.slint]
#       Render FILE (default: LunaDash's), install the theme and rebuild the
#       initramfs. Asks for the administrator password.
#   lunadash-boot-animation --build-only DIR [--size WxH] [--font FONT] [FILE.slint]
#       Only write the theme to DIR.
#
# The animation plays in the middle of the screen as a loop of two seconds:
# SlintLu renders the component's first two seconds at 30 frames a second, so
# its animation should come back to where it started by then. The frames are
# WxH pixels (560x240 by default, LunaDash's), on the colour of their top-left
# corner. Slint's software renderer draws them: positions, sizes, opacity and
# colours animate, rotated elements do not turn. The services systemd starts
# are listed in the bottom-right corner in FONT (JetBrains Mono Light 10 by
# default), and password prompts appear under the animation.
set -euo pipefail

theme=lunadash
file=/usr/share/lunadash/data/boot/boot-animation.slint
size=560x240
font='JetBrains Mono Light 10'
fps=30
build_only=

while (($#)); do
    case $1 in
        --build-only) build_only=${2:?--build-only takes a directory}; shift 2 ;;
        --size) size=${2:?--size takes WIDTHxHEIGHT}; shift 2 ;;
        --font) font=${2:?--font takes a font name}; shift 2 ;;
        -h|--help) sed -n '2,17s/^# \{0,1\}//p' "$0"; exit 0 ;;
        -*) echo "Unknown option $1" >&2; exit 2 ;;
        *) file=$1; shift ;;
    esac
done

slintlu=${LUDASH_SLINTLU:-/usr/libexec/lunadash/slintlu}
[[ -x $slintlu ]] || slintlu=$(command -v slintlu) ||
    { echo 'SlintLu is not installed.' >&2; exit 1; }
[[ -f $file ]] || { echo "No such file: $file" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
dir=$work/$theme
mkdir -p "$dir"

echo "Rendering $file…"
info=$("$slintlu" render "$file" --out "$dir" --prefix frame- --size "$size" --fps "$fps" --seconds 2)
frames=$(sed -n 's/.*"frames":\([0-9]*\).*/\1/p' <<<"$info")
background=$(sed -n 's/.*"background":"#\([0-9a-f]\{6\}\)".*/\1/p' <<<"$info")
background=${background:-000000}
channel() { awk -v value=$((16#${background:$1:2})) 'BEGIN { printf "%.3f", value / 255 }'; }
red=$(channel 0) green=$(channel 2) blue=$(channel 4)

cat >"$dir/$theme.plymouth" <<EOF
[Plymouth Theme]
Name=LunaDash
Description=LunaDash's boot animation, rendered from a Slint component
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/$theme
ScriptFile=/usr/share/plymouth/themes/$theme/$theme.script
# Not read by the script plugin: plymouth-populate-initrd copies this font into
# the initramfs, where the script's text needs it (fc-match finds it by name,
# without the size).
Font=${font% [0-9]*}
EOF

{
    cat <<EOF
# LunaDash's boot splash: the animation in the middle, the services systemd
# starts in the bottom-right corner, password prompts under the animation.
Window.SetBackgroundTopColor($red, $green, $blue);
Window.SetBackgroundBottomColor($red, $green, $blue);

font = "$font";

fun wrap (a, n) {
    return a - Math.Int(a / n) * n;
}
EOF
    for ((i = 0; i < frames; i++)); do
        printf 'frames[%d] = Image("frame-%04d.png");\n' "$i" "$i"
    done
    cat <<EOF
frame_count = $frames;

animation = Sprite();
animation.SetX(Window.GetX() + Window.GetWidth() / 2 - frames[0].GetWidth() / 2);
animation.SetY(Window.GetY() + Window.GetHeight() / 2 - frames[0].GetHeight() / 2);
# Plymouth refreshes a script 50 times a second; the frames run at $fps.
ticks = 0;
fun refresh_callback () {
    animation.SetImage(frames[wrap(Math.Int(ticks * $fps / 50), frame_count)]);
    ticks++;
}
Plymouth.SetRefreshFunction(refresh_callback);

# The newest line at the bottom, older ones fading above it.
log_lines = 5;
log_count = 0;
for (i = 0; i < log_lines; i++)
    log_sprites[i] = Sprite();
fun show_log () {
    for (i = 0; i < log_lines; i++) {
        index = log_count - 1 - i;
        if (index < 0) {
            log_sprites[i].SetOpacity(0);
        } else {
            image = Image.Text(log_text[wrap(index, log_lines)], 0.72, 0.78, 0.92, 1, font, "right");
            log_sprites[i].SetImage(image);
            log_sprites[i].SetX(Window.GetX() + Window.GetWidth() - image.GetWidth() - 36);
            log_sprites[i].SetY(Window.GetY() + Window.GetHeight() - 36 - (i + 1) * image.GetHeight() * 1.5);
            log_sprites[i].SetOpacity(1 - i * 0.18);
        }
    }
}
fun log_callback (text) {
    log_text[wrap(log_count, log_lines)] = text;
    log_count++;
    show_log();
}
Plymouth.SetUpdateStatusFunction(log_callback);
Plymouth.SetDisplayMessageFunction(log_callback);

prompt_sprite = Sprite();
entry_sprite = Sprite();
fun show_prompt (prompt, entry) {
    below = animation.GetY() + frames[0].GetHeight() + 24;
    prompt_image = Image.Text(prompt, 0.93, 0.95, 1, 1, font, "center");
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetY(below);
    prompt_sprite.SetOpacity(1);
    entry_image = Image.Text(entry + " ", 0.93, 0.95, 1, 1, font, "center");
    entry_sprite.SetImage(entry_image);
    entry_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - entry_image.GetWidth() / 2);
    entry_sprite.SetY(below + prompt_image.GetHeight() * 1.8);
    entry_sprite.SetOpacity(1);
}
fun display_password_callback (prompt, bullets) {
    dots = "";
    for (i = 0; i < bullets; i++)
        dots = dots + "•";
    show_prompt(prompt, dots);
}
fun display_question_callback (prompt, entry) {
    show_prompt(prompt, entry);
}
fun display_normal_callback () {
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
EOF
} >"$dir/$theme.script"

if [[ -n $build_only ]]; then
    mkdir -p "$build_only"
    cp -r "$dir/." "$build_only/"
    echo "Theme written to $build_only"
    exit 0
fi

echo 'Installing the theme and rebuilding the initramfs (administrator password)…'
pkexec sh -c 'rm -rf "$2" && cp -r "$1" "$2" && plymouth-set-default-theme -R "$3"' \
    sh "$dir" "/usr/share/plymouth/themes/$theme" "$theme"
echo "The boot animation is now $file."
