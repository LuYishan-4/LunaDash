#!/bin/sh
# Mirror text between the Wayland clipboard and the XWayland selection.
# Requires wl-clipboard, xclip, and timeout.

set -u

: "${DISPLAY:=}"
last=""

while :; do
    wl="$(timeout 0.4 wl-paste --no-newline 2>/dev/null || true)"
    x=""
    if [ -n "$DISPLAY" ]; then
        x="$(xclip -selection clipboard -o 2>/dev/null || true)"
    fi

    if [ -n "$wl" ] && [ "$wl" != "$last" ]; then
        if [ -n "$DISPLAY" ]; then
            printf '%s' "$wl" | xclip -selection clipboard -i 2>/dev/null || true
        fi
        last="$wl"
    elif [ -n "$x" ] && [ "$x" != "$last" ]; then
        printf '%s' "$x" | wl-copy --no-newline 2>/dev/null || true
        last="$x"
    fi
    sleep 0.4
done
