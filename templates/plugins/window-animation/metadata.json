{
  "schemaVersion": 2,
  "sdk": {"name": "LunaDash", "apiVersion": 2},
  "id": "org.example.window-animation",
  "name": "window-animation plugin",
  "description": "Customizes the host window animation template.",
  "version": "1.0.0",
  "author": "Plugin author",
  "icon": "preferences-desktop-effects",
  "tags": ["Animation", "Windows", "Native"],
  "type": "effect",
  "target": "window-animation",
  "mode": "replace",
  "entry": "liblunadash-window-animation-template.so",
  "enabledByDefault": false,
  "settings": {
    "duration": {"type": "integer", "default": 240, "minimum": 0, "maximum": 600},
    "enterOffset": {"type": "integer", "default": 12, "minimum": -100, "maximum": 100},
    "focusOpacity": {"type": "number", "default": 0.82, "minimum": 0, "maximum": 1},
    "exitScale": {"type": "number", "default": 0.9, "minimum": 0.5, "maximum": 1},
    "easing": {"type": "string", "default": "outCubic", "enum": ["linear", "outCubic", "outQuint", "inOutCubic"]}
  }
}
