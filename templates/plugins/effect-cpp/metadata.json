{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.example.rules",
  "name": "Application workspace rule",
  "version": "1.0.0",
  "description": "LunaDash plugin template.",
  "author": "Your name",
  "type": "effect",
  "target": "window-rules",
  "mode": "augment",
  "enabledByDefault": false,
  "settings": {
    "appId": {
      "type": "string",
      "default": "kitty"
    },
    "workspace": {
      "type": "integer",
      "default": 1,
      "minimum": 0,
      "maximum": 9
    }
  },
  "entry": "librules.so"
}
