{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.example.window-switcher",
  "name": "Workspace window previews",
  "version": "1.0.1a",
  "description": "Replace the Alt+Tab content using current-workspace thumbnails.",
  "author": "Your name",
  "type": "quickshell",
  "target": "window-switcher",
  "mode": "replace",
  "enabledByDefault": false,
  "settings": {
    "opacity": {
      "type": "number",
      "default": 1,
      "minimum": 0,
      "maximum": 1,
      "label": "Opacity",
      "control": "slider"
    }
  },
  "entry": "Main.qml"
}
