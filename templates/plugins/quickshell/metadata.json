{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.example.panel",
  "name": "Taskbar greeting",
  "version": "1.0.0",
  "description": "LunaDash plugin template.",
  "author": "Your name",
  "type": "quickshell",
  "target": "panel",
  "mode": "augment",
  "enabledByDefault": false,
  "settings": {
    "showGreeting": {
      "type": "boolean",
      "control": "toggle",
      "label": "Show greeting",
      "default": true
    },
    "opacity": {
      "type": "number",
      "control": "slider",
      "label": "Opacity",
      "default": 1,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05
    }
  },
  "entry": "Main.qml"
}
