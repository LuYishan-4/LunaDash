# Local source release: run scripts/make-source.sh first, then makepkg -Cfs.
pkgname=ludash
pkgver=0.1.0
pkgrel=1
pkgdesc='C++ and OpenGL Wayland tiling desktop'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'quickshell' 'qt6-translations' 'wayland' 'libglvnd' 'dbus')
makedepends=('cmake' 'ninja')
optdepends=('xorg-xwayland: X11 protocol compatibility server'
            'networkmanager: Network status and connection management'
            'nm-connection-editor: Graphical network setup'
            'noto-fonts-cjk: Traditional Chinese interface fonts'
            'mesa: Mesa OpenGL drivers'
            'foot: Full interactive Wayland terminal'
            'fcitx5: Input method framework'
            'fcitx5-qt: Fcitx integration for Qt'
            'fcitx5-configtool: Input method settings')
source=("ludash-${pkgver}.tar.gz")
sha256sums=('SKIP') # Local generated source, not a downloaded release.

build() {
  cmake -S "ludash-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "ludash-${pkgver}/README.md" "$pkgdir/usr/share/doc/ludash/README.md"
}
