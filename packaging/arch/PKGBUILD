# Local source release: run scripts/make-source.sh first, then makepkg -Cfs.
pkgname=ludash
pkgver=1.0.2a
pkgrel=1
pkgdesc='C++ Wayland tiling desktop with OpenGL and optional Vulkan rendering'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('ffmpeg' 'wayland' 'pam' 'wlroots0.20' 'libglvnd' 'fontconfig' 'freetype2' 'dbus' 'xorg-xwayland' 'libinput' 'libxkbcommon' 'systemd-libs' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'xdg-desktop-portal-wlr>=0.8.4' 'pipewire' 'libpulse' 'polkit' 'polkit-kde-agent' 'git' 'python' 'cmake' 'ninja' 'glib2' 'gdk-pixbuf2' 'curl' 'shared-mime-info' 'fcitx5' 'fcitx5-qt' 'fcitx5-configtool' 'brightnessctl' 'ddcutil' 'grim' 'slurp' 'wl-clipboard' 'networkmanager' 'network-manager-applet' 'wireplumber' 'pavucontrol' 'bluez' 'bluez-utils' 'blueman' 'system-config-printer' 'gnome-disk-utility' 'partitionmanager' 'firewalld' 'seahorse' 'pciutils' 'usbutils' 'udisks2' 'power-profiles-daemon' 'gnome-control-center')
makedepends=('cmake' 'ninja' 'pkgconf' 'glib2-devel' 'wayland-protocols' 'vulkan-headers' 'nlohmann-json' 'rust')
optdepends=('kitty: Optional default terminal'
            'dolphin: Optional default file manager'
            'fish: Optional interactive shell'
            'qt6-shadertools: Build OpenGL shader plugins with the LunaDash SDK'
            'noto-fonts-cjk: CJK interface fonts'
            'mesa: Mesa OpenGL drivers')
optdepends+=('vulkan-icd-loader: Vulkan loader for Vulkan rendering'
             'vulkan-driver: GPU-specific Vulkan driver')
# The shell is Slint on SlintLu (built below). Quickshell is only needed for a
# legacy QML LunaDash-Shell checkout.
optdepends+=('quickshell: Run a legacy QML LunaDash-Shell'
             'qt6-wayland: Run a legacy QML LunaDash-Shell'
             'qt6-multimedia: Video wallpapers in a legacy QML LunaDash-Shell')
source=("ludash-${pkgver}.tar.gz" "ludash-shell.tar.gz" "ludash-slintlu.tar.gz")
sha256sums=('SKIP' 'SKIP' 'SKIP') # Locally generated sources, not downloaded releases.

build() {
  cmake -S "ludash-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DLUDASH_SHELL_SOURCE_DIR="$srcdir/LunaDash-Shell" \
    -DLUDASH_SLINTLU_SOURCE_DIR="$srcdir/SlintLu"

  # Slint's tikv-jemallocator 0.7.0 is incompatible with Rust 1.99+:
  # ld.lld: error: undefined symbol: _rjem_malloc (and 130+ more).
  # Drop the jemalloc feature from slint-compiler before building.
  local slint_src
  slint_src=$(find build/_deps -maxdepth 1 -type d -name 'slint-src' -print -quit 2>/dev/null || true)
  if [ -n "$slint_src" ]; then
    # 1) Remove jemalloc from Cargo.toml default features
    if [ -f "$slint_src/tools/compiler/Cargo.toml" ]; then
      sed -i 's/^default = \["renderer-software", "image-default-formats", "jemalloc", "bundle-translations", "cpp", "rust", "python"\]/default = ["renderer-software", "image-default-formats", "bundle-translations", "cpp", "rust", "python"]/' "$slint_src/tools/compiler/Cargo.toml"
    fi
    # 2) Patch CMakeLists.txt to NOT append jemalloc to CORROSION_FEATURES
    local slint_cpp_cmake="$slint_src/api/cpp/CMakeLists.txt"
    if [ -f "$slint_cpp_cmake" ]; then
      sed -i '/# Enable jemalloc, except when cross-compiling/,/endif()/ s/list(APPEND slint_compiler_features "jemalloc")/# list(APPEND slint_compiler_features "jemalloc")  # DISABLED: incompatible with Rust 1.99+/' "$slint_cpp_cmake"
    fi
  fi

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "ludash-${pkgver}/README.md" "$pkgdir/usr/share/doc/ludash/README.md"
  install -Dm644 "ludash-${pkgver}/docs/en/LOGIN_SESSION.md" "$pkgdir/usr/share/doc/ludash/LOGIN_SESSION.md"
  install -Dm644 "ludash-${pkgver}/docs/en/ARCHITECTURE.md" "$pkgdir/usr/share/doc/ludash/ARCHITECTURE.md"
  install -Dm644 "ludash-${pkgver}/docs/en/GRAPHICS.md" "$pkgdir/usr/share/doc/ludash/GRAPHICS.md"
  install -Dm644 "ludash-${pkgver}/docs/en/FILES.md" "$pkgdir/usr/share/doc/ludash/FILES.md"
  install -Dm644 "ludash-${pkgver}/docs/en/DISPLAY_AND_STARTUP.md" "$pkgdir/usr/share/doc/ludash/DISPLAY_AND_STARTUP.md"
  install -Dm644 "ludash-${pkgver}/docs/en/SCREEN_CAPTURE.md" "$pkgdir/usr/share/doc/ludash/SCREEN_CAPTURE.md"
  install -Dm644 "ludash-${pkgver}/docs/en/NYXNIRI_DESKTOP.md" "$pkgdir/usr/share/doc/ludash/NYXNIRI_DESKTOP.md"
  install -dm755 "$pkgdir/usr/share/doc/ludash/zh"
  for doc in LOGIN_SESSION ARCHITECTURE GRAPHICS FILES DISPLAY_AND_STARTUP SCREEN_CAPTURE NYXNIRI_DESKTOP; do
    install -Dm644 "ludash-${pkgver}/docs/zh/${doc}.md" "$pkgdir/usr/share/doc/ludash/zh/${doc}.md"
  done
}
