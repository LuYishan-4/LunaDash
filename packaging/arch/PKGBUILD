# Local source release: run scripts/make-source.sh first, then makepkg -Cfs.
pkgname=ludash
pkgver=0.1.0
pkgrel=3
pkgdesc='C++ and OpenGL Wayland tiling desktop'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'quickshell' 'qt6-translations' 'wayland' 'libglvnd' 'dbus' 'kitty' 'fish' 'xorg-xwayland' 'libinput' 'libxkbcommon' 'systemd-libs')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('networkmanager: Network status and connection management'
            'nm-connection-editor: Graphical network setup'
            'wireplumber: Native volume and microphone controls'
            'pavucontrol: Audio device and routing settings'
            'power-profiles-daemon: System power profile controls'
            'blueman: Bluetooth pairing and adapter settings'
            'system-config-printer: Printer configuration'
            'gnome-disk-utility: Disk and storage settings'
            'gnome-control-center: Optional account and date settings'
            'xfce4-settings: Optional default application editor'
            'noto-fonts-cjk: Traditional Chinese interface fonts'
            'mesa: Mesa OpenGL drivers'
            'fcitx5: Input method framework'
            'fcitx5-qt: Fcitx integration for Qt'
            'fcitx5-configtool: Input method settings')
source=("ludash-${pkgver}.tar.gz")
sha256sums=('SKIP') # Local generated source, not a downloaded release.

build() {
  cmake -S "ludash-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DLUDASH_USE_LIBINPUT=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "ludash-${pkgver}/README.md" "$pkgdir/usr/share/doc/ludash/README.md"
  install -Dm644 "ludash-${pkgver}/docs/LOGIN_SESSION.md" "$pkgdir/usr/share/doc/ludash/LOGIN_SESSION.md"
}
