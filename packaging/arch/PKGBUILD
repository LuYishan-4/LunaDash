# Local source release: run scripts/make-source.sh first, then makepkg -Cfs.
pkgname=ludash
pkgver=1.0.2a
pkgrel=1
pkgdesc='C++ Wayland tiling desktop with OpenGL and optional Vulkan rendering'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('ffmpeg' 'wayland' 'pam' 'wlroots0.20' 'libglvnd' 'fontconfig' 'freetype2' 'dbus' 'xorg-xwayland' 'libinput' 'libxkbcommon' 'systemd-libs' 'xdg-desktop-portal' 'xdg-desktop-portal-gnome' 'xdg-desktop-portal-gtk' 'xdg-desktop-portal-wlr>=0.8.4' 'pipewire' 'libpulse' 'polkit' 'polkit-kde-agent' 'git' 'python' 'cmake' 'ninja' 'glib2' 'gdk-pixbuf2' 'curl' 'shared-mime-info' 'fcitx5' 'fcitx5-qt' 'fcitx5-configtool' 'brightnessctl' 'ddcutil' 'grim' 'slurp' 'wl-clipboard' 'networkmanager' 'network-manager-applet' 'wireplumber' 'pavucontrol' 'bluez' 'bluez-utils' 'blueman' 'system-config-printer' 'gnome-disk-utility' 'partitionmanager' 'firewalld' 'seahorse' 'pciutils' 'usbutils' 'udisks2' 'power-profiles-daemon' 'gnome-control-center')
makedepends=('cmake' 'ninja' 'pkgconf' 'glib2-devel' 'wayland-protocols' 'vulkan-headers' 'nlohmann-json' 'rust')
optdepends=('kitty: Optional default terminal'
            'dolphin: Optional default file manager'
            'fish: Optional interactive shell'
            'noto-fonts-cjk: CJK interface fonts'
            'mesa: Mesa OpenGL drivers')
optdepends+=('mpvpaper: Video wallpapers (AUR)')
optdepends+=('ananicy-cpp: Keeps the desktop responsive under CPU load (rules installed)')
optdepends+=('vulkan-icd-loader: Vulkan loader for Vulkan rendering'
             'vulkan-driver: GPU-specific Vulkan driver')
# Users may tune the scheduling rule; upgrades keep their edits.
backup=('etc/ananicy.d/lunadash-session.rules')
source=("ludash-${pkgver}.tar.gz" "ludash-shell.tar.gz" "ludash-slintlu.tar.gz")
sha256sums=('SKIP' 'SKIP' 'SKIP') # Locally generated sources, not downloaded releases.

build() {
  cmake -S "ludash-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DLUDASH_SHELL_SOURCE_DIR="$srcdir/LunaDash-Shell" \
    -DLUDASH_SLINTLU_SOURCE_DIR="$srcdir/SlintLu"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "ludash-${pkgver}/README.md" "$pkgdir/usr/share/doc/ludash/README.md"
}
