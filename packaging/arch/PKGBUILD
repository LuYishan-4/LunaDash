# Local source release: run scripts/make-source.sh first, then makepkg -Cfs.
pkgname=ludash
pkgver=1.0.1a
pkgrel=1
pkgdesc='C++ and OpenGL Wayland tiling desktop'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'quickshell' 'qt6-translations' 'wayland' 'wlroots0.20' 'libglvnd' 'dbus' 'kitty' 'fish' 'xorg-xwayland' 'libinput' 'libxkbcommon' 'systemd-libs' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'xdg-desktop-portal-wlr>=0.8.4' 'pipewire' 'polkit' 'polkit-kde-agent' 'git' 'python' 'cmake' 'ninja' 'glib2' 'shared-mime-info' 'fcitx5' 'fcitx5-qt' 'fcitx5-configtool' 'brightnessctl' 'ddcutil' 'grim' 'slurp' 'wl-clipboard' 'networkmanager' 'network-manager-applet' 'wireplumber' 'pavucontrol' 'bluez' 'bluez-utils' 'blueman' 'system-config-printer' 'gnome-disk-utility' 'partitionmanager' 'firewalld' 'seahorse' 'pciutils' 'usbutils' 'udisks2' 'power-profiles-daemon' 'gnome-control-center')
makedepends=('cmake' 'ninja' 'pkgconf' 'glib2-devel' 'wayland-protocols')
optdepends=('qt6-shadertools: Build OpenGL shader plugins with the LunaDash SDK'
            'noto-fonts-cjk: CJK interface fonts'
            'mesa: Mesa OpenGL drivers')
source=("ludash-${pkgver}.tar.gz")
sha256sums=('SKIP') # Local generated source, not a downloaded release.

build() {
  cmake -S "ludash-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "ludash-${pkgver}/README.md" "$pkgdir/usr/share/doc/ludash/README.md"
  install -Dm644 "ludash-${pkgver}/docs/en/LOGIN_SESSION.md" "$pkgdir/usr/share/doc/ludash/LOGIN_SESSION.md"
  install -Dm644 "ludash-${pkgver}/docs/en/ARCHITECTURE.md" "$pkgdir/usr/share/doc/ludash/ARCHITECTURE.md"
  install -Dm644 "ludash-${pkgver}/docs/en/GRAPHICS.md" "$pkgdir/usr/share/doc/ludash/GRAPHICS.md"
  install -Dm644 "ludash-${pkgver}/docs/en/FILES.md" "$pkgdir/usr/share/doc/ludash/FILES.md"
  install -Dm644 "ludash-${pkgver}/docs/en/DISPLAY_AND_STARTUP.md" "$pkgdir/usr/share/doc/ludash/DISPLAY_AND_STARTUP.md"
  install -Dm644 "ludash-${pkgver}/docs/en/SCREEN_CAPTURE.md" "$pkgdir/usr/share/doc/ludash/SCREEN_CAPTURE.md"
  install -dm755 "$pkgdir/usr/share/doc/ludash/zh"
  for doc in LOGIN_SESSION ARCHITECTURE GRAPHICS FILES DISPLAY_AND_STARTUP SCREEN_CAPTURE; do
    install -Dm644 "ludash-${pkgver}/docs/zh/${doc}.md" "$pkgdir/usr/share/doc/ludash/zh/${doc}.md"
  done
}
